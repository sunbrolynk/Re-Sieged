{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "RESIEGED_AGENT": "Claude"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$CLAUDE_PROJECT_DIR/tools/checks/policy.py\" session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$CLAUDE_PROJECT_DIR/tools/checks/policy.py\" claude-pretool"
          }
        ]
      }
    ]
  }
}

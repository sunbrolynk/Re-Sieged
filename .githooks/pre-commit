#!/bin/sh
# Re-Sieged pre-commit hook. Logic lives in tools/checks/policy.py (one source of rules).
# Enable once per clone:  git config core.hooksPath .githooks
PY=$(command -v python3 || command -v python || command -v py)
if [ -z "$PY" ]; then
  echo "Re-Sieged pre-commit: Python 3 not found; install it so repository checks can run." >&2
  exit 1
fi
exec "$PY" "$(git rev-parse --show-toplevel)/tools/checks/policy.py" staged
